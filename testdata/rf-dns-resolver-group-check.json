{
  "log": {
    "disabled": true
  },
  "dns": {
    "servers": [
      {
        "tag": "cloudflare-doh",
        "type": "https",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query"
      },
      {
        "tag": "rf-resolver-cloudflare",
        "type": "rf_resolver_group",
        "primary": [
          "cloudflare-doh"
        ]
      }
    ],
    "final": "rf-resolver-cloudflare"
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "default_domain_resolver": {
      "server": "rf-resolver-cloudflare",
      "strategy": "ipv4_only"
    },
    "final": "direct"
  }
}
