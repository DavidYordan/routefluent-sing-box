{
  "log": {
    "disabled": true
  },
  "dns": {
    "servers": [
      {
        "tag": "doh",
        "type": "https",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query"
      },
      {
        "tag": "invalid",
        "type": "rf_resolver_group",
        "primary": [
          "doh"
        ],
